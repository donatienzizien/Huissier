# Base de données (schéma public — cabinets, super admin)
DATABASE_URL="postgresql://loginet:changeme@localhost:5432/loginet_huissiers?schema=public"

# JWT
JWT_ACCESS_SECRET="change-this-access-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="change-this-refresh-secret"
JWT_REFRESH_EXPIRES="7d"

# Bcrypt
BCRYPT_COST=12

# SMTP (notifications email)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@loginet-huissiers.com"
SMTP_PASS="changeme"
SMTP_FROM="LOGINET Huissiers <notifications@loginet-huissiers.com>"

# Stockage des PDF générés (actes). En Docker, ce chemin est monté comme volume.
ACTES_STORAGE_PATH="/app/storage"

# Laissez vide en local (Puppeteer utilise son propre Chromium téléchargé).
# En Docker, déjà fixé à /usr/bin/chromium dans le Dockerfile.
PUPPETEER_EXECUTABLE_PATH=

# App
PORT=3000
NODE_ENV="production"
CORS_ORIGIN="https://app.loginet-huissiers.com"
