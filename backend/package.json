        "puppeteer": "^23.5.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.5",
        "@nestjs/schematics": "^10.2.3",
        "@nestjs/testing": "^10.4.5",
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.13",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.7.4",
        "@types/nodemailer": "^6.4.16",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.11.10",
        "jest": "^29.7.0",
