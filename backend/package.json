{
    "name": "loginet-huissiers-backend",
    "version": "1.0.0",
    "description": "Plateforme de gestion pour cabinets d'huissiers - API Backend",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "prestart:dev": "node -e \"const           fs=require('fs');fs.mkdirSync('dist/prisma',{recursive:true});fs.copyFileSync('prisma/tenant-schema.sql','dist/prisma/tenant-schema.sql')\"",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:migrate:dev": "prisma migrate dev",
        "seed": "ts-node prisma/seed.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage"
    },
    "dependencies": {
        "@nestjs/common": "^10.4.0",
        "@nestjs/config": "^3.2.3",
        "@nestjs/core": "^10.4.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/mapped-types": "^2.0.6",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.0",
        "@nestjs/schedule": "^4.1.1",
        "@nestjs/throttler": "^6.2.1",
        "@prisma/client": "^5.20.0",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^16.4.5",
        "exceljs": "^4.4.0",
        "file-type": "^16.5.4",
        "handlebars": "^4.7.8",
        "helmet": "^7.1.0",
        "html-to-docx": "^1.8.0",
        "jszip": "^3.10.1",
        "nodemailer": "^6.9.15",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
